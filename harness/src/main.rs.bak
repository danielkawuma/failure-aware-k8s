use anyhow::Result;
use chrono::Utc;
use csv::Writer;
use reqwest::Client;
use serde::Serialize;
use std::fs::OpenOptions;
use std::time::{Duration, Instant};
use tokio::time::sleep;

#[derive(Serialize)]
struct HttpObservation {
    timestamp_utc: String,
    http_status: u16,
    latency_ms: f64,
    success: bool,
}

#[tokio::main]
async fn main() -> Result<()> {
    let url = "http://102.34.160.87:30364";

    let client = Client::builder()
        .timeout(Duration::from_secs(3))
        .build()?;

    let file = OpenOptions::new()
        .create(true)
        .append(true)
        .open("../experiments/baseline/scenario-b/http-observations.csv")?;

    let mut writer = Writer::from_writer(file);

    loop {
        let timestamp = Utc::now();
        let start = Instant::now();

        let result = client.get(url).send().await;

        let latency_ms = start.elapsed().as_secs_f64() * 1000.0;

        match result {
            Ok(response) => {
                let status = response.status().as_u16();

                let observation = HttpObservation {
                    timestamp_utc: timestamp.to_rfc3339(),
                    http_status: status,
                    latency_ms,
                    success: response.status().is_success(),
                };

                writer.serialize(&observation)?;
                writer.flush()?;

                println!(
                    "{} | HTTP={} | latency={:.3} ms",
                    timestamp.format("%d %b %Y %H:%M:%S%.3f UTC"),
                    status,
                    latency_ms
                );
            }

            Err(error) => {
                let observation = HttpObservation {
                    timestamp_utc: timestamp.to_rfc3339(),
                    http_status: 0,
                    latency_ms,
                    success: false,
                };

                writer.serialize(&observation)?;
                writer.flush()?;

                println!(
                    "{} | HTTP=FAILED | latency={:.3} ms | {}",
                    timestamp.format("%d %b %Y %H:%M:%S%.3f UTC"),
                    latency_ms,
                    error
                );
            }
        }

        sleep(Duration::from_secs(1)).await;
    }
}