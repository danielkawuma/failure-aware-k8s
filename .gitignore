# Rust build artifacts
target/
controller/target/
harness/target/

# Generated analysis results (regenerated by make reproduce)
analysis/results/*.csv
analysis/results/*.json
analysis/results/*.png
analysis/results/*.pdf
!analysis/results/.gitkeep

# Runtime / temporary files
*.log
*.pid
*.tmp
*.swp
*~

# Raw experiment logs are evidence and must be committed
!experiments/**/*.log

# Python generated files
__pycache__/
*.py[cod]
.venv/
venv/

# Editor / IDE / OS metadata
.vscode/
.idea/
.DS_Store
Thumbs.db

# Credentials and local environment
.env
.env.*
*.pem
*.key
*.token
kubeconfig
*.kubeconfig
.ssh/

# Database dumps (may contain credentials; kept locally only)
backups/mariadb/

# Temporary experiment/debug files
*-invalid/
