<mxfile><diagram name="Nine-layer reference"><mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="1. User &amp; Application" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=14;" vertex="1" parent="1"><mxGeometry x="62" y="36" width="500" height="64" as="geometry"/></mxCell><mxCell id="3" value="OpenMRS EMR (backend, frontend, gateway, MariaDB) and an Nginx service; clinical HTTP requests measure availability" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="630" y="36" width="1040" height="64" as="geometry"/></mxCell><mxCell id="4" value="2. API &amp; Service" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=14;" vertex="1" parent="1"><mxGeometry x="62" y="117" width="500" height="64" as="geometry"/></mxCell><mxCell id="5" value="Standard Kubernetes Service / NodePort; one Pod per application component" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="630" y="117" width="1040" height="64" as="geometry"/></mxCell><mxCell id="6" value="3. Orchestration &amp; Control Plane +" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDEDED;strokeColor=#000000;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="62" y="198" width="500" height="64" as="geometry"/></mxCell><mxCell id="7" value="Controller watches the native Ready=Unknown signal; Lease, grace period and taints unchanged" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDEDED;strokeColor=#000000;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="630" y="198" width="1040" height="64" as="geometry"/></mxCell><mxCell id="8" value="4. Scheduling &amp; Provisioning +" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDEDED;strokeColor=#000000;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="62" y="279" width="500" height="64" as="geometry"/></mxCell><mxCell id="9" value="Controller preserves the Pod (tolerations) or releases it; selects an eligible candidate; kube-scheduler places" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDEDED;strokeColor=#000000;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="630" y="279" width="1040" height="64" as="geometry"/></mxCell><mxCell id="10" value="5. Virtualization &amp; Runtime" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=14;" vertex="1" parent="1"><mxGeometry x="62" y="360" width="500" height="64" as="geometry"/></mxCell><mxCell id="11" value="K3s / containerd runtime unchanged" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="630" y="360" width="1040" height="64" as="geometry"/></mxCell><mxCell id="12" value="6. Storage &amp; Data Plane +" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDEDED;strokeColor=#000000;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="62" y="441" width="500" height="64" as="geometry"/></mxCell><mxCell id="13" value="NFS-backed volumes; controller fences the original worker at the NFS server before releasing a database Pod" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDEDED;strokeColor=#000000;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="630" y="441" width="1040" height="64" as="geometry"/></mxCell><mxCell id="14" value="7. Monitoring &amp; Telemetry +" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDEDED;strokeColor=#000000;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="62" y="522" width="500" height="64" as="geometry"/></mxCell><mxCell id="15" value="Bounded probes only after suspicion; node history collected about every 30 s for reliability scoring" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDEDED;strokeColor=#000000;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="630" y="522" width="1040" height="64" as="geometry"/></mxCell><mxCell id="16" value="8. Security &amp; Governance" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=14;" vertex="1" parent="1"><mxGeometry x="62" y="603" width="500" height="64" as="geometry"/></mxCell><mxCell id="17" value="Standard namespace / RBAC model; data remains on the local OpenStack infrastructure" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="630" y="603" width="1040" height="64" as="geometry"/></mxCell><mxCell id="18" value="9. Evaluation &amp; Feedback Loop +" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDEDED;strokeColor=#000000;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="62" y="684" width="500" height="64" as="geometry"/></mxCell><mxCell id="19" value="Collected metrics: decisions, Pod identity, clinical HTTP success, fault and restoration times, resource use; node history feeds the reliability score" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDEDED;strokeColor=#000000;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="630" y="684" width="1040" height="64" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>