# Copy to scripts/cluster/cluster.env (not committed) and set your own values.
# Addresses below are placeholders.
SSH_USER=ubuntu
SSH_KEY=~/.ssh/k8s-aware
K3S_VERSION=v1.36.4+k3s1
SERVER_IP=10.10.0.10
# name=ip pairs; Worker1 is the fault target, Worker2 the recovery target
WORKERS="k3s-worker1=10.10.0.11 k3s-worker2=10.10.0.12 k3s-worker3=10.10.0.13 k3s-worker4=10.10.0.14"
# NFS export for the OpenMRS volumes on the control-plane VM (set NFS_SETUP=no to skip)
NFS_SETUP=yes
NFS_EXPORT=/srv/nfs/k8s
NFS_CLIENT_CIDR=10.10.0.0/24
