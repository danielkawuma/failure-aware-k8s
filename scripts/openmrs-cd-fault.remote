#!/usr/bin/env bash
set -Eeuo pipefail

ACTION="${1:-}"
POD_IP="${2:-}"

API_IP="${OPENMRS_CD_API_IP:-102.34.160.89}"
STATE="/run/openmrs-cd-api-partition"
TAG="failure-aware-openmrs-cd"

log() {
    echo "[CD FAULT] $*" >&2
}

fail() {
    log "ERROR: $*"
    exit 2
}

valid_ip() {
    local ip="$1"
    local a b c d extra

    [[ "$ip" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] ||
        return 1

    IFS='.' read -r a b c d extra <<< "$ip"

    [[ -z "${extra:-}" ]] || return 1

    for octet in "$a" "$b" "$c" "$d"; do
        [[ "$octet" =~ ^[0-9]{1,3}$ ]] || return 1
        (( 10#$octet <= 255 )) || return 1
    done
}

api_rule() {
    iptables -w 5 "$1" OUTPUT \
        -p tcp \
        -d "$API_IP" \
        --dport 6443 \
        -m comment --comment "$TAG-api" \
        -j DROP
}

db_rule() {
    iptables -w 5 "$1" FORWARD \
        -p tcp \
        -d "$POD_IP" \
        --dport 3306 \
        -m comment --comment "$TAG-db" \
        -j DROP
}

load_state() {
    [[ -f "$STATE" ]] || return 1

    local saved_api saved_pod extra

    read -r saved_api saved_pod extra < "$STATE" ||
        fail "Unreadable state"

    [[ -z "${extra:-}" ]] ||
        fail "Malformed state"

    [[ "$saved_api" == "$API_IP" ]] ||
        fail "API mismatch"

    valid_ip "$saved_pod" ||
        fail "Invalid stored Pod IP"

    if [[ -n "$POD_IP" && "$POD_IP" != "$saved_pod" ]]; then
        fail "Pod IP mismatch"
    fi

    POD_IP="$saved_pod"
}

status_fault() {
    local output forward

    output="$(iptables -w 5 -S OUTPUT)" || {
        echo UNKNOWN
        return 2
    }

    forward="$(iptables -w 5 -S FORWARD)" || {
        echo UNKNOWN
        return 2
    }

    if [[ -f "$STATE" ]]; then
        load_state

        if api_rule -C 2>/dev/null &&
           db_rule -C 2>/dev/null; then
            echo ACTIVE
            return 0
        fi

        echo UNKNOWN
        return 2
    fi

    # Any tagged rule without its state file is ambiguous.
    if grep -Fq "$TAG" <<< "$output" ||
       grep -Fq "$TAG" <<< "$forward"; then
        echo UNKNOWN
        return 2
    fi

    # Detect legacy untagged rules from earlier experiments.
    if grep -E -- '-A OUTPUT .*--dport 6443 .* -j DROP' \
        <<< "$output" |
        grep -Fq -- "-d $API_IP/32"; then
        echo UNKNOWN
        return 2
    fi

    if grep -E -- '-A FORWARD .*--dport 3306 .* -j DROP' \
        <<< "$forward" | grep -q .; then
        echo UNKNOWN
        return 2
    fi

    echo INACTIVE
    return 1
}

apply_fault() {
    valid_ip "$API_IP" || fail "Invalid API IP"
    valid_ip "$POD_IP" || fail "Invalid Pod IP"

    local result rc=0

    result="$(status_fault)" || rc=$?

    [[ "$rc" -eq 1 && "$result" == INACTIVE ]] ||
        fail "Fault state is not positively INACTIVE: $result"

    api_rule -I || fail "API rule installation failed"

    if ! db_rule -I; then
        api_rule -D || true
        fail "Database rule installation failed"
    fi

    if ! printf '%s %s\n' "$API_IP" "$POD_IP" > "$STATE"; then
        db_rule -D || true
        api_rule -D || true
        fail "State persistence failed"
    fi

    result="$(status_fault)" || fail "Fault verification failed"

    [[ "$result" == ACTIVE ]] ||
        fail "Fault state inconsistent after apply"

    echo ACTIVE
}

clear_fault() {
    [[ -f "$STATE" ]] ||
        fail "Missing state file; refusing ambiguous cleanup"

    load_state

    db_rule -C 2>/dev/null ||
        fail "Database rule missing; manual inspection required"

    api_rule -C 2>/dev/null ||
        fail "API rule missing; manual inspection required"

    db_rule -D || fail "Database rule removal failed"
    api_rule -D || fail "API rule removal failed"

    rm -f "$STATE"

    local result rc=0

    result="$(status_fault)" || rc=$?

    [[ "$rc" -eq 1 && "$result" == INACTIVE ]] ||
        fail "Fault cleanup could not be verified"

    echo INACTIVE
}

case "$ACTION" in
    apply)
        apply_fault
        ;;
    status)
        status_fault
        ;;
    clear)
        clear_fault
        ;;
    *)
        echo "Usage: $0 apply|status|clear POD_IP" >&2
        exit 2
        ;;
esac